# Environment for docker compose. Copy to .env and fill in.

# Address players use to reach the hub. Must not be localhost unless the player
# runs on the same machine.
BASE_URL=http://192.168.1.10:3817

# Encrypts stored hub configurations. Generate once with:
#   openssl rand -hex 32
# Changing it later invalidates every manifest URL already installed.
SECRET_KEY=

# Address players use to reach this addon.
PUBLIC_URL=http://192.168.1.10:3819

# The hub's manifest URL, copied from its configure page after saving a config.
HUB_URL=

# Where Stremio's streaming server answers. Inside the compose network the
# service name works; outside it, the host and port.
STREAMING_URL=http://stremio-server:11470
